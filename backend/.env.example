# Postgres connection (Railway injects DATABASE_URL automatically; for local dev use:
# postgresql+asyncpg://user:password@localhost:5432/hunger_birds)
DATABASE_URL=postgresql+asyncpg://hunger_birds:hunger_birds@localhost:5432/hunger_birds

# Redis connection (Railway injects REDIS_URL automatically)
REDIS_URL=redis://localhost:6379/0

# Resend (transactional email for OTP codes)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Hunger Birds <onboarding@resend.dev>

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_EMAIL_DOMAIN=bitmesra.ac.in

# When true, OTP codes are also returned in the API response so you can log
# in during local dev without a working Resend account. NEVER enable in prod.
OTP_DEBUG_ECHO=true

# Cloudinary (image uploads, client uploads directly using a signed request
# minted by the backend)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=hunger_birds

CORS_ORIGINS=*
